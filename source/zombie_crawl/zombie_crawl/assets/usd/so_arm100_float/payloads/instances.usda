#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "Base" (
        prepend references = @./geometries.usd@</Geometries/Base>
    )
    {
        over "Base" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/Base/VisualMaterials/tn__3d_printed_>
        }

        def Scope "VisualMaterials"
        {
            def Material "tn__3d_printed_" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/tn__3d_printed_>
            )
            {
            }
        }
    }

    def Xform "Base_1" (
        prepend references = @./geometries.usd@</Geometries/Base>
    )
    {
        over "Base" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

